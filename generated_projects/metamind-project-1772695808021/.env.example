# Database Configuration
DATABASE_URL=postgresql://healthcare_user:healthcare_password@localhost:5432/healthcare_db
POSTGRES_PASSWORD=healthcare_password

# Redis Configuration
REDIS_URL=redis://:redis_password@localhost:6379/0
REDIS_PASSWORD=redis_password

# Application Configuration
LOG_LEVEL=info
WORKERS=4
DEBUG=false

# Monitoring
GRAFANA_PASSWORD=admin

# Security (Generate strong passwords for production!)
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-here-change-in-production

# HIPAA Compliance
ENABLE_AUDIT_LOGGING=true
DATA_RETENTION_DAYS=2555  # 7 years for HIPAA

# ML Model Configuration
ANOMALY_THRESHOLD=0.7
MODEL_RETRAIN_INTERVAL_HOURS=24

# Alert Configuration
CRITICAL_ALERT_THRESHOLD=0.8
WARNING_ALERT_THRESHOLD=0.5
ALERT_COOLDOWN_SECONDS=300

# Performance
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30
QUERY_TIMEOUT=10