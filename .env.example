# MetaMind Environment Configuration

# ============================================
# LLM Provider Configuration
# ============================================
# Options: ollama, xai, openai, anthropic
LLM_PROVIDER=ollama

# --------------------------------------------
# Ollama Configuration (Local, Free)
# --------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --------------------------------------------
# xAI Grok Configuration (Fast, $5/1M tokens)
# --------------------------------------------
# Get API key from: https://console.x.ai/
# XAI_API_KEY=your-xai-api-key-here
# XAI_MODEL=grok-beta
# XAI_BASE_URL=https://api.x.ai/v1

# --------------------------------------------
# OpenAI Configuration ($30/1M tokens)
# --------------------------------------------
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4

# --------------------------------------------
# Anthropic Configuration ($15/1M tokens)
# --------------------------------------------
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================
# Database Configuration
# ============================================
DB_PATH=./metamind.db

# ============================================
# API Configuration
# ============================================
PORT=8000

# ============================================
# Application Settings
# ============================================
MAX_ITERATIONS=5
CONFIDENCE_THRESHOLD=0.85

# ============================================
# Frontend Configuration (for Streamlit)
# ============================================
BACKEND_URL=http://localhost:8000